        "# ══════════════════════════════════════════════════════════════════\n",
        "# PRUEBA CON DATOS REALES: GOOGLE SPEECH COMMANDS (VERSIÓN ROBUSTA)\n",
        "# Usa librosa para audio - sin problemas de versiones\n",
        "# ══════════════════════════════════════════════════════════════════\n",
        "!pip install librosa soundfile --quiet\n",
        "\n",
        "import torch\n",
        "import torch.nn as nn\n",
        "import torch.nn.functional as F\n",
        "import torch.optim as optim\n",
        "from torch.utils.data import Dataset, DataLoader\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from sklearn.metrics import roc_auc_score\n",
        "from sklearn.preprocessing import label_binarize\n",
        "import librosa\n",
        "import os, gc, time, warnings\n",
        "warnings.filterwarnings('ignore')\n",
        "\n",
        "device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
        "print(f\"Usando dispositivo: {device}\")\n",
        "\n",
        "# ─── Descargar dataset (si no se descargó aún) ───\n",
        "if not os.path.exists('./data/SpeechCommands/yes'):\n",
        "    print(\"Descargando Google Speech Commands (~2.3 GB)...\")\n",
        "    !wget -q -P ./data/ http://download.tensorflow.org/data/speech_commands_v0.02.tar.gz\n",
        "    !mkdir -p ./data/SpeechCommands\n",
        "    print(\"Descomprimiendo...\")\n",
        "    !tar -xzf ./data/speech_commands_v0.02.tar.gz -C ./data/SpeechCommands/\n",
        "    print(\"✅ Descarga completa.\")\n",
        "else:\n",
        "    print(\"✅ Dataset ya descargado.\")\n",
        "\n",
        "# ─── Clases a usar ───\n",
        "CLASES = ['yes', 'no', 'up', 'down']\n",
        "print(f\"Clases: {CLASES}\")\n",
        "\n",
        "# ─── Dataset personalizado con librosa ───\n",
        "class SpeechCommandsDataset(Dataset):\n",
        "    def __init__(self, root_dir, clases, max_len=16000, limit_per_class=200):\n",
        "        self.archivos = []\n",
        "        self.labels = []\n",
        "        self.max_len = max_len\n",
        "\n",
        "        for idx, clase in enumerate(clases):\n",
        "            clase_dir = os.path.join(root_dir, clase)\n",
        "            if os.path.exists(clase_dir):\n",
        "                archivos = [f for f in os.listdir(clase_dir) if f.endswith('.wav')][:limit_per_class]\n",
        "                for archivo in archivos:\n",
        "                    self.archivos.append(os.path.join(clase_dir, archivo))\n",
        "                    self.labels.append(idx)\n",
        "\n",
        "        print(f\"Total de muestras: {len(self.archivos)}\")\n",
        "\n",
        "    def __len__(self):\n",
        "        return len(self.archivos)\n",
        "\n",
        "    def __getitem__(self, idx):\n",
        "        # Cargar audio con librosa (16kHz, mono)\n",
        "        y, _ = librosa.load(self.archivos[idx], sr=16000, mono=True)\n",
        "\n",
        "        # Rellenar o recortar\n",
        "        if len(y) < self.max_len:\n",
        "            y = np.pad(y, (0, self.max_len - len(y)))\n",
        "        else:\n",
        "            y = y[:self.max_len]\n",
        "\n",
        "        return torch.FloatTensor(y), self.labels[idx]\n",
        "\n",
        "# ─── Cargar datos ───\n",
        "dataset_full = SpeechCommandsDataset('./data/SpeechCommands', CLASES, limit_per_class=200)\n",
        "\n",
        "# Split\n",
        "train_size = int(0.8 * len(dataset_full))\n",
        "test_size = len(dataset_full) - train_size\n",
        "train_dataset, test_dataset = torch.utils.data.random_split(dataset_full, [train_size, test_size])\n",
        "\n",
        "train_loader = DataLoader(train_dataset, batch_size=16, shuffle=True, num_workers=2)\n",
        "test_loader = DataLoader(test_dataset, batch_size=16, shuffle=False, num_workers=2)\n",
        "\n",
        "print(f\"Train: {len(train_dataset)} | Test: {len(test_dataset)}\")\n",
        "\n",
        "# ─── Función para extraer MFCC con librosa ───\n",
        "def extraer_mfcc(waveform_np, n_mfcc=20):\n",
        "    \"\"\"Extrae MFCC y normaliza.\"\"\"\n",
        "    mfcc = librosa.feature.mfcc(y=waveform_np, sr=16000, n_mfcc=n_mfcc, n_fft=400, hop_length=160)\n",
        "    # Pad/truncate a 101 frames\n",
        "    if mfcc.shape[1] < 101:\n",
        "        mfcc = np.pad(mfcc, ((0,0), (0, 101-mfcc.shape[1])))\n",
        "    else:\n",
        "        mfcc = mfcc[:, :101]\n",
        "    return mfcc.astype(np.float32)\n",
        "\n",
        "print(\"✅ Dataset y extractor de MFCC listos.\")\n",
        "\n",
        "# ══════════════════════════════════════════════════════════════════\n",
        "# FUNCIONES DE ACTIVACIÓN\n",
        "# ══════════════════════════════════════════════════════════════════\n",
        "class GenalActivation(nn.Module):\n",
        "    def __init__(self, theta_init=1.0):\n",
        "        super().__init__()\n",
        "        self.theta = nn.Parameter(torch.tensor(theta_init, dtype=torch.float32))\n",
        "    def forward(self, x):\n",
        "        k = F.softplus(self.theta) + 1e-6\n",
        "        return x * torch.sigmoid(x / k)\n",
        "\n",
        "class GenalShift(nn.Module):\n",
        "    def __init__(self, theta_init=1.0, beta_init=0.0):\n",
        "        super().__init__()\n",
        "        self.theta = nn.Parameter(torch.tensor(theta_init, dtype=torch.float32))\n",
        "        self.beta = nn.Parameter(torch.tensor(beta_init, dtype=torch.float32))\n",
        "    def forward(self, x):\n",
        "        k = torch.clamp(F.softplus(self.theta), 1e-6, 2.0)\n",
        "        return x * torch.sigmoid((x - self.beta) / k)\n",
        "\n",
        "# ══════════════════════════════════════════════════════════════════\n",
        "# MODELO CNN LIGERO\n",
        "# ══════════════════════════════════════════════════════════════════\n",
        "class AudioCNN(nn.Module):\n",
        "    def __init__(self, activation, n_classes=4, n_mfcc=20):\n",
        "        super().__init__()\n",
        "        self.conv1 = nn.Conv2d(1, 16, kernel_size=3, padding=1)\n",
        "        self.bn1 = nn.BatchNorm2d(16)\n",
        "        self.conv2 = nn.Conv2d(16, 32, kernel_size=3, padding=1)\n",
        "        self.bn2 = nn.BatchNorm2d(32)\n",
        "        self.pool = nn.MaxPool2d(2)\n",
        "        self.dropout = nn.Dropout(0.3)\n",
        "\n",
        "        # 20/4=5, 101/4=25 -> 32*5*25 = 4000\n",
        "        self.fc1 = nn.Linear(32 * 5 * 25, 64)\n",
        "        self.fc2 = nn.Linear(64, n_classes)\n",
        "        self.act = activation\n",
        "\n",
        "    def forward(self, x):\n",
        "        x = self.pool(self.act(self.bn1(self.conv1(x))))\n",
        "        x = self.pool(self.act(self.bn2(self.conv2(x))))\n",
        "        x = x.view(x.size(0), -1)\n",
        "        x = self.dropout(self.act(self.fc1(x)))\n",
        "        x = self.fc2(x)\n",
        "        return x\n",
        "\n",
        "# ══════════════════════════════════════════════════════════════════\n",
        "# ENTRENAMIENTO\n",
        "# ══════════════════════════════════════════════════════════════════\n",
        "def entrenar_y_evaluar(nombre, activacion_ctor, epochs=20):\n",
        "    print(f\"\\n--- Entrenando con {nombre} ---\")\n",
        "    torch.manual_seed(42)\n",
        "    modelo = AudioCNN(activacion_ctor(), n_classes=len(CLASES)).to(device)\n",
        "    optimizer = optim.Adam(modelo.parameters(), lr=0.001, weight_decay=1e-4)\n",
        "    criterio = nn.CrossEntropyLoss()\n",
        "\n",
        "    start = time.time()\n",
        "\n",
        "    for epoch in range(epochs):\n",
        "        modelo.train()\n",
        "        total_loss = 0\n",
        "        for waveforms, labels in train_loader:\n",
